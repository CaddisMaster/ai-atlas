{
  "permissions": {
    "allow": [
      "Bash(./test.sh)",
      "Bash(./test.sh *)",
      "Bash(.venv/bin/pytest*)",
      "Bash(.venv/bin/ruff check*)",
      "Bash(python -m atlas *)",
      "Bash(.venv/bin/python -m atlas *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(gh pr view*)",
      "Bash(gh pr list*)",
      "Bash(gh issue view*)",
      "Bash(gh issue list*)"
    ],
    "deny": [
      "Read(./*.db)",
      "Bash(git add -A*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/changelog-guard.sh"
          }
        ]
      }
    ]
  }
}
